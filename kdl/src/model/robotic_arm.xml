<mujoco model="robotic_arm">
  <!-- angle=radian：关节角与朝向都用弧度，和 URDF 一致。
       朝向一律写 quat="w x y z"，不用 euler + eulerseq：
       四元数与欧拉角序列约定无关，后续编辑或 URDF<->MJCF 往返转换时不会
       因为约定对不上而悄悄把连杆姿态转错（这正是 mujoco_ros2_control 自带的
       URDF->MJCF 转换脚本 mj_saveLastXML 的输出形式）。
       下面每个 body 的 quat 都由注释里给出的 URDF rpy 按
       R = Rz(yaw) * Ry(pitch) * Rx(roll) 换算得到。 -->
  <compiler angle="radian" autolimits="true"/>
  <!-- implicitfast：MuJoCo 推荐的隐式积分器，对带 damping/接触的铰接臂数值更稳。 -->
  <option integrator="implicitfast"/>
  <asset>
    <mesh name="base_link" file="base_link.STL" />
    <mesh name="link1" file="link1.STL" />
    <mesh name="link2" file="link2.STL" />
    <mesh name="link3" file="link3.STL" />
    <mesh name="link4" file="link4.STL" />
  </asset>
  <worldbody>
    <body name="base_link">
      <inertial pos="-9.52016243616072e-15 -1.94289029309402e-16 0.0155191781345583" mass="0.446116144380579" fullinertia="0.000224798050494485 0.00138255058840876 0.00122839549734328 -2.18020596920716e-10 -7.25060202849681e-19 -2.37030607855116e-20" />
      <geom type="mesh" rgba="0.866666666666667 0.909803921568627 1 1" mesh="base_link" />
      <site name="tool_site" pos="0 0 0" size="0.01" />
      <!-- URDF joint1 origin rpy = 1.5708 -1.57 -3.1416 -->
      <body name="link1" pos="0 -0.04 0.05" quat="0.499799959274 -0.49980179807 -0.500198124855 -0.500199959263">
        <inertial pos="0.150031524729698 0.000191995103078102 0.0344853139404591" mass="0.43178795433662" fullinertia="5.96075244798525e-05 0.00272008694008324 0.00274655104559429 -4.07370544541132e-06 -1.02661773419375e-07 2.06377860208473e-08" />
        <joint name="joint1" pos="0 0 0" axis="0 0 1" range="-1.57 1.57" actuatorfrcrange="-50 50" />
        <geom type="mesh" rgba="0.847058823529412 0.847058823529412 0.847058823529412 1" mesh="link1" />
        <!-- URDF joint2 origin rpy = 1.5708 0.0 0.0 -->
        <body name="link2" pos="0.374 0 0.0401" quat="0.707105482511 0.707108079859 0 0">
          <inertial pos="0.205484012122796 -0.00549986783103082 0.0186225676272804" mass="0.334546886253206" fullinertia="9.93613919225459e-05 0.000582195736690295 0.000556148638754133 8.10971210408094e-10 -4.61050169328864e-09 5.70676865975426e-09" />
          <joint name="joint2" pos="0 0 0" axis="0 -1 0" range="-3.0 3.0" actuatorfrcrange="-50 50" />
          <geom type="mesh" rgba="0.866666666666667 0.909803921568627 1 1" mesh="link2" />
          <!-- URDF joint3 origin rpy = -1.5708 -1.5708 -1.5708 -->
          <body name="link3" pos="0.3384 -0.0055 0.045" quat="-0.000003896022 -0.707106781181 0.000001298674 -0.707106781181">
            <inertial pos="0.00045693106510647 0.0120159218838146 0.0326962826671975" mass="0.0818036914981158" fullinertia="2.58771620872542e-05 3.05802737829727e-05 2.3497726615304e-05 1.52000429986836e-07 1.71868944443329e-08 3.75710826679309e-07" />
            <joint name="joint3" pos="0 0 0" axis="0 0 1" range="-3.14 3.14" actuatorfrcrange="-50 50" />
            <geom type="mesh" rgba="0.847058823529412 0.847058823529412 0.847058823529412 1" mesh="link3" />
            <!-- URDF joint4 origin rpy = -1.5708 -1.5708 3.14 -->
            <body name="link4" pos="0.00079568 0.018983 0.043" quat="0.500399839961 0.499601678107 -0.500398004818 0.499599840046">
              <inertial pos="0.0717111929893778 -0.0115466248724582 0.0198054015294321" mass="0.269974503355347" fullinertia="0.000158676016051897 0.000126778289759083 0.000154960757569298 7.59760657382795e-08 5.56013658017894e-08 2.07997464437305e-09" />
              <joint name="joint4" pos="0 0 0" axis="0 0 1" range="-1.57 1.57" actuatorfrcrange="-50 50" />
              <geom type="mesh" rgba="0.847058823529412 0.847058823529412 0.847058823529412 1" mesh="link4" />
              <site name="ee_site" pos="0.1165 0 0" size="0.01" />
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <contact>
    <exclude body1="base_link" body2="link1" />
    <exclude body1="link1" body2="link2" />
    <exclude body1="link2" body2="link3" />
    <exclude body1="link3" body2="link4" />
  </contact>
  <!-- 执行器：位置伺服（MuJoCo 内置 PD）。
       ctrl 的语义就是"目标关节角"，正好对应 ros2_control 的 position 命令接口，
       所以 JointTrajectoryController 可以不加任何 PID 直接驱动这套模型。
       dampratio="1.0" 时 MuJoCo 会按该关节的实际等效惯量自动算出临界阻尼的 kv，
       因此只需要调 kp：kp 越大越"硬"、稳态下沉越小，过大则在数值上发散。
       下面这组 kp 按本臂（4 自由度，连杆质量 0.08~0.45 kg、惯量 2.6e-5~2.7e-3 kg·m²）
       选取：以 src/model/robotic_arm.xml 的 joint1~joint4（kp=400/3000/1800/100）为基准，
       按等效惯量比约 1/4 缩放得到，仍需在仿真里实测微调。
       ctrlrange 取关节行程，MuJoCo 会把设定值夹在行程内。

       effort 上限：与 URDF 各关节的 <limit effort> 一致——本模型四个关节均为
       50 N·m。actuatorfrcrange 是 MuJoCo 侧的物理夹取，改 URDF 的 effort 时
       必须同步改这里。

       若要改成纯力矩控制（ros2_control 侧用 effort 命令接口 + 力矩控制器），
       用同目录的 robotic_arm_torque.xml / scene_torque.xml。
       MuJoCo 不允许在运行期切换执行器类型，所以这是二选一的编译期决定。 -->
  <actuator>
    <position name="motor1" joint="joint1" kp="100" dampratio="1.0" ctrllimited="true" ctrlrange="-1.57 1.57" />
    <position name="motor2" joint="joint2" kp="800" dampratio="1.0" ctrllimited="true" ctrlrange="-3.0 3.0" />
    <position name="motor3" joint="joint3" kp="500" dampratio="1.0" ctrllimited="true" ctrlrange="-3.14 3.14" />
    <position name="motor4" joint="joint4" kp="50" dampratio="1.0" ctrllimited="true" ctrlrange="-1.57 1.57" />
  </actuator>
  <sensor>
    <actuatorpos name="motor1_p" actuator="motor1" />
    <actuatorpos name="motor2_p" actuator="motor2" />
    <actuatorpos name="motor3_p" actuator="motor3" />
    <actuatorpos name="motor4_p" actuator="motor4" />
    <actuatorvel name="motor1_v" actuator="motor1" />
    <actuatorvel name="motor2_v" actuator="motor2" />
    <actuatorvel name="motor3_v" actuator="motor3" />
    <actuatorvel name="motor4_v" actuator="motor4" />
    <actuatorfrc name="motor1_f" actuator="motor1" noise="1e-3" />
    <actuatorfrc name="motor2_f" actuator="motor2" noise="1e-3" />
    <actuatorfrc name="motor3_f" actuator="motor3" noise="1e-3" />
    <actuatorfrc name="motor4_f" actuator="motor4" noise="1e-3" />
    <framepos name="ee_pos" objtype="site" objname="ee_site" />
    <framequat name="ee_quat" objtype="site" objname="ee_site" />
  </sensor>
</mujoco>
