<mujoco model="robotic_arm">
  <!-- 力矩控制版机器人本体（与 robotic_arm.xml 的几何/惯量/关节完全一致）。
       唯一差别：<actuator> 段用 <motor>（原生接受力矩指令）替换 <position> 位置伺服。

       为什么要单独一份：
         ros2_control 的 effort 命令接口只支持 MuJoCo 的 motor/general 执行器，
         对 position/velocity 执行器会直接报错并跳过（见 mujoco_ros2_control 的
         docs/hardware_interface.rst 兼容表）。而执行器类型是编译期二选一、不可运行时
         切换，所以 position 版（robotic_arm.xml）与 torque 版（本文件）必须并存。

       本文件是 scene_torque.xml 的 include 目标；由 kdl_effort_controller 输出 τ，
       MuJoCo 直接把 ctrl 当关节力矩施加。

       注：下面 body 里的 quat 由 URDF rpy 按 R = Rz(yaw)*Ry(pitch)*Rx(roll) 换算；
           joint 轴与 URDF 逐一对应，符号一致（前馈力矩才不会有方向性错误）。 -->
  <compiler angle="radian" autolimits="true"/>
  <!-- implicitfast：MuJoCo 推荐的隐式积分器，对带 damping/接触的铰接臂数值更稳。 -->
  <option integrator="implicitfast"/>
  <asset>
    <mesh name="base_link" file="base_link.STL" />
    <mesh name="link1" file="link1.STL" />
    <mesh name="link2" file="link2.STL" />
    <mesh name="link3" file="link3.STL" />
    <mesh name="link4" file="link4.STL" />
    <mesh name="link5" file="link5.STL" />
    <mesh name="link6" file="link6.STL" />
  </asset>
  <worldbody>
    <body name="base_link">
      <inertial pos="-0.00360621702328832 5.13965852572684e-05 -0.00437548460570378" mass="0.905716018714615" fullinertia="0.00107148927922179 0.00144104333999584 0.00244792600293045 2.76094582641941e-06 -5.48596189361244e-07 2.22549999381976e-07" />
      <geom type="mesh" rgba="0.650980392156863 0.619607843137255 0.588235294117647 1" mesh="base_link" />
      <site name="tool_site" pos="0 0 0" size="0.01" />
      <body name="link1" pos="6.34132927793407e-05 -0.00167405073291106 0.0278500000000087">
        <inertial pos="-0.000108374983294121 -0.0224173657123978 0.0295694936286941" mass="1.91180538368796" fullinertia="0.00130826953517784 0.00190867031535885 0.00177080127699075 1.3668660920291e-06 1.38971343647627e-05 1.26824657951645e-06" />
        <!-- 关节阻尼（damping）当前保持「模型原值」：joint1~joint5 不设阻尼，joint6 保留 2.0。
             这样做的目的：如实观察「控制器激活前 ctrl=0 → 臂自由下落」的现象
             （见《力矩控制问题报告》§3）。力矩模式下 MuJoCo 不再提供任何 PD，
             没有控制器出力时臂会一路掉到关节限位。
             若要缓解该问题，可按各关节的重力负载量级加阻尼（j2 约 25、j3 约 18；
             手腕关节惯量极小，需按 J/c 取很小的值，否则会像被锁死）。 -->
        <joint name="joint1" pos="0 0 0" axis="0 0 1" range="-3.14 3.14" actuatorfrcrange="-50 50" />
        <geom type="mesh" rgba="0.650980392156863 0.619607843137255 0.588235294117647 1" mesh="link1" />
        <!-- URDF joint2 origin rpy = -1.5707963267949 -1.5708 0 -->
        <body name="link2" pos="0.00565491862295636 0.0185517283813911 0.0710733482199691" quat="0.499999081698 -0.499999081698 -0.500000918300 -0.500000918300">
          <inertial pos="0.375032807584103 -0.00767142856848219 -0.0148750517361231" mass="1.09233144358037" fullinertia="0.000562645054167591 0.00825256907491947 0.00858584566040506 4.6355173743639e-07 -5.41332728898313e-05 -1.2040814647427e-06" />
          <joint name="joint2" pos="0 0 0" axis="0 0 -1" range="-1.57 1.57" actuatorfrcrange="-50 50" />
          <geom type="mesh" rgba="0.701960784313725 0.670588235294118 0.933333333333333 1" mesh="link2" />
          <!-- URDF joint3 origin rpy = 3.14159265358979 0 0 -->
          <body name="link3" pos="0.500001547205985 -0.00750000000003981 0.0418960557056171" quat="0 1 0 0">
            <inertial pos="0.396708620293581 -0.0009580050394698 0.0146574939500043" mass="0.750870225721497" fullinertia="0.000311759468382739 0.00280789973164969 0.00305821466409237 -4.43262109210123e-06 2.95134858752333e-06 -6.86575257856084e-07" />
            <joint name="joint3" pos="0 0 0" axis="0 0 -1" range="-2.8 2.8" actuatorfrcrange="-50 50" />
            <geom type="mesh" rgba="0.647058823529412 0.854901960784314 0.533333333333333 1" mesh="link3" />
            <!-- URDF joint4 origin rpy = 3.14159265358979 0 1.5708 -->
            <body name="link4" pos="0.493372719987381 -0.000717203264851807 -0.0115" quat="0 0.707105482511 0.707108079859 0">
              <inertial pos="0.0388635088998436 0.0683350036809159 -0.0302743627631186" mass="0.328855136025888" fullinertia="0.000130515381077466 8.67316206395657e-05 0.000124148178178434 -1.58524988603632e-07 2.47556859422373e-07 -5.55843117742173e-08" />
              <joint name="joint4" pos="0 0 0" axis="0 0 -1" range="-1.82 1.92" actuatorfrcrange="-100 100" />
              <geom type="mesh" rgba="0.698039215686274 0.698039215686274 0.698039215686274 1" mesh="link4" />
              <!-- URDF joint5 origin rpy = 1.5707963267949 0 1.5708 -->
              <body name="link5" pos="0.0420000017681742 0.0760000060786439 -0.0298499999999999" quat="0.499999081698 0.499999081698 0.500000918300 0.500000918300">
                <inertial pos="0.0409963218118283 -0.000737375741447381 -0.0449408930326747" mass="0.107863966418761" fullinertia="2.27221737578051e-05 2.42204415320291e-05 3.18656466025932e-05 2.69721515117386e-08 5.25283476817911e-07 5.16755491617417e-09" />
                <joint name="joint5" pos="0 0 0" axis="-0.0571545044239792 0 -0.998365345263972" range="-0.4 0.4" actuatorfrcrange="-50 50" />
                <geom type="mesh" rgba="0.698039215686274 0.698039215686274 0.698039215686274 1" mesh="link5" />
                <!-- URDF joint6 origin rpy = 0.0171393597075962 1.51361065936655 3.14159265358978 -->
                <body name="link6" pos="0.109242825291171 -0.00191951430536242 -0.0510772149208419" quat="0.005883890063 -0.686577109745 0.006230365380 0.727006488801">
                  <inertial pos="3.46944695195361e-18 -1.17961196366423e-16 0.0196990985019004" mass="0.150213928644987" fullinertia="7.59512548879523e-05 7.59512548879523e-05 0.00011238690149753 6.71670657393058e-21 -1.05879118406788e-20 -2.26088313745444e-19" />
                  <joint name="joint6" pos="0 0 0" axis="0 0 1" range="-3.14 3.14" damping="2.0" actuatorfrcrange="-50 50" />
                  <geom type="mesh" rgba="0.113725490196078 0.113725490196078 0.113725490196078 1" mesh="link6" />
                  <site name="ee_site" pos="0 0 0.05" size="0.01" />
                  <!-- 末端挂载立方体：有质量参与动力学，但不参与碰撞
                  <body name="ee_box" pos="0 0 -0.175">
                    <inertial pos="0 0 0" mass="0.63" diaginertia="0.000167 0.000167 0.000167"/>
                    <geom type="box" size="0.175 0.175 0.175" rgba="1 0 0 1" contype="0" conaffinity="0"/>
                  </body> -->
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <contact>
    <!-- 相邻连杆：本来就不该互撞，排除。 -->
    <exclude body1="base_link" body2="link1" />
    <exclude body1="link1" body2="link2" />
    <exclude body1="link2" body2="link3" />
    <exclude body1="link3" body2="link4" />
    <exclude body1="link4" body2="link5" />
    <exclude body1="link5" body2="link6" />

    <!-- 非相邻连杆之间的自碰撞排除。
         为什么必须排除：本模型的连杆碰撞直接用 SolidWorks 导出的三角网格，MuJoCo 对
         非凸网格用**凸包**近似，会把实际仍有间隙的连杆误判成接触。实测在正常目标位形
         q=[0.5,-0.4,0.6,0.3,0.2,0.5] 下，link3 与 link5 之间"穿"了 1.1 mm，产生的约束力
         恰好抵消 j4 的净力矩（qfrc_constraint[3] = -0.538 N·m），表现为「关节怎么都到
         不了目标」，实测 j4 差 0.35 rad —— 这不是控制问题，是碰撞几何的假接触。
         （<motor> 力矩模式下没有位置伺服"硬顶"过去，所以这个假接触会长时间卡住关节。）
         若要保留真实自碰撞检测：删掉下面这些 exclude，并把各连杆的 geom 换成简化碰撞
         几何（capsule/box），而不是直接用外形网格。 -->
    <exclude body1="base_link" body2="link2" />
    <exclude body1="base_link" body2="link3" />
    <exclude body1="base_link" body2="link4" />
    <exclude body1="base_link" body2="link5" />
    <exclude body1="base_link" body2="link6" />
    <exclude body1="link1" body2="link3" />
    <exclude body1="link1" body2="link4" />
    <exclude body1="link1" body2="link5" />
    <exclude body1="link1" body2="link6" />
    <exclude body1="link2" body2="link4" />
    <exclude body1="link2" body2="link5" />
    <exclude body1="link2" body2="link6" />
    <exclude body1="link3" body2="link5" />
    <exclude body1="link3" body2="link6" />
    <exclude body1="link4" body2="link6" />
  </contact>
  <!-- 执行器：纯力矩（motor）。
       ctrl 的语义就是关节力矩 [N·m]，直接对应 ros2_control 的 effort 命令接口。
       gear="1" 表示 1:1 直连（插件不做 gear 缩放，ctrl 原样施加）。
       ctrllimited + ctrlrange 取 URDF <limit effort>（joint4 为 ±100），
       与 <ros2_control> 声明的 effort 命令接口和 kdl_effort_controller 的输出限幅一致。
       actuatorfrcrange 已在各 joint 上声明，是最后一道物理夹取。 -->
  <actuator>
    <motor name="motor1" joint="joint1" gear="1" ctrllimited="true" ctrlrange="-50 50" />
    <motor name="motor2" joint="joint2" gear="1" ctrllimited="true" ctrlrange="-50 50" />
    <motor name="motor3" joint="joint3" gear="1" ctrllimited="true" ctrlrange="-50 50" />
    <motor name="motor4" joint="joint4" gear="1" ctrllimited="true" ctrlrange="-100 100" />
    <motor name="motor5" joint="joint5" gear="1" ctrllimited="true" ctrlrange="-50 50" />
    <motor name="motor6" joint="joint6" gear="1" ctrllimited="true" ctrlrange="-50 50" />
  </actuator>
  <sensor>
    <actuatorpos name="motor1_p" actuator="motor1" />
    <actuatorpos name="motor2_p" actuator="motor2" />
    <actuatorpos name="motor3_p" actuator="motor3" />
    <actuatorpos name="motor4_p" actuator="motor4" />
    <actuatorpos name="motor5_p" actuator="motor5" />
    <actuatorpos name="motor6_p" actuator="motor6" />
    <actuatorvel name="motor1_v" actuator="motor1" />
    <actuatorvel name="motor2_v" actuator="motor2" />
    <actuatorvel name="motor3_v" actuator="motor3" />
    <actuatorvel name="motor4_v" actuator="motor4" />
    <actuatorvel name="motor5_v" actuator="motor5" />
    <actuatorvel name="motor6_v" actuator="motor6" />
    <actuatorfrc name="motor1_f" actuator="motor1" noise="1e-3" />
    <actuatorfrc name="motor2_f" actuator="motor2" noise="1e-3" />
    <actuatorfrc name="motor3_f" actuator="motor3" noise="1e-3" />
    <actuatorfrc name="motor4_f" actuator="motor4" noise="1e-3" />
    <actuatorfrc name="motor5_f" actuator="motor5" noise="1e-3" />
    <actuatorfrc name="motor6_f" actuator="motor6" noise="1e-3" />
    <framepos name="ee_pos" objtype="site" objname="ee_site" />
    <framequat name="ee_quat" objtype="site" objname="ee_site" />
  </sensor>
</mujoco>
