<mujoco model="robotic_arm">
  <!--
    ==========================================================================
    关节阻尼（沿用 src/model/robotic_arm.xml 的实测选定值：joint1/2 = 0.2，joint3/4 = 0.02）
    ==========================================================================
    为什么加：开机时物理先跑、控制器晚约 0.3 s 才接管，这段自由落体让臂撞进控制器
    的"重力锁位"，产生欠阻尼振荡，joint1 力矩峰值一度逼近 50 N·m 上限，joint4 还会
    瞬时冲出限位。加阻尼后力矩峰值大幅下降。

    为什么分关节给：收益和代价来自不同关节。
      · 收益几乎全在 joint1/joint2 —— 它们承担重力负载，也是力矩峰值的来源，
        且它们的 P 增益大，加阻尼几乎无代价。
      · 代价几乎全在 joint3/joint4 —— 它们 P 增益极小（500 / 50），阻尼力矩
        会直接变成跟随滞后。整定时间常数 τ ≈ (kd + damping) / kp，所以同样的
        阻尼值在这两个关节上的代价是 joint1 的几十倍。

    注意：阻尼对控制器是**未建模扰动** —— URDF 里没有 <dynamics>，KDL 的
    inverseDynamics 也不含关节阻尼，所以前馈补不掉它，只能靠 PID 反馈。
    静止时阻尼力矩为零，所以不影响稳态精度，只影响运动中的跟随。
    ==========================================================================
  -->
  <!-- angle=radian：关节角与朝向都用弧度，和 URDF 一致。
       朝向一律写 quat="w x y z"，不用 euler + eulerseq：
       四元数与欧拉角序列约定无关，后续编辑或 URDF<->MJCF 往返转换时不会
       因为约定对不上而悄悄把连杆姿态转错（这正是 mujoco_ros2_control 自带的
       URDF->MJCF 转换脚本 mj_saveLastXML 的输出形式）。
       下面每个 body 的 quat 都由注释里给出的 URDF rpy 按
       R = Rz(yaw) * Ry(pitch) * Rx(roll) 换算得到。 -->
  <compiler angle="radian" autolimits="true"/>
  <!-- implicitfast：MuJoCo 推荐的隐式积分器，对带 damping/接触的铰接臂数值更稳。 -->
  <option integrator="implicitfast"/>
  <asset>
    <mesh name="base_link" file="base_link.STL" />
    <mesh name="link1" file="link1.STL" />
    <mesh name="link2" file="link2.STL" />
    <mesh name="link3" file="link3.STL" />
    <mesh name="link4" file="link4.STL" />
  </asset>
  <worldbody>
    <body name="base_link">
      <inertial pos="-9.27036225562006E-15 7.38592952492789E-07 0.0155299485832002" mass="0.445927939104524" fullinertia="0.000224769873618828 0.00138253371851121 0.00122838375537572 -2.18020596913895e-10 -5.52265481609804e-19 -2.51299344174685e-20" />
      <geom type="mesh" rgba="0.866666666666667 0.909803921568627 1 1" mesh="base_link" />
      <site name="tool_site" pos="0 0 0" size="0.01" />
      <body name="link1" pos="0 0.042 0.05" quat="0.499998163397 0.499999999997 -0.499999999997 0.500001836603">
        <inertial pos="0.163587015176246 0.000202798582474142 0.0350397770187157" mass="0.422761931253973" fullinertia="0.0000569493202543751 0.00242791349103459 0.00245118578495609 -0.00000203221997946206 -8.63264983106718e-8 -2.59016529851239e-9" />
        <!-- URDF joint1 origin rpy = 1.5708 -1.5708 0 -->
        <joint name="joint1" pos="0 0 0" axis="0 0 1" range="-1.5708 1.5708" actuatorfrcrange="-50 50" damping="0.2" />
        <geom type="mesh" rgba="1 1 1 1" mesh="link1" />
        <body name="link2" pos="0.374 0 0.0401" quat="0.707105482511 0.707108079859 0 0">
          <inertial pos="0.258483690032714 -0.00550281148638793 2.4003006262735E-06" mass="0.352210008949705" fullinertia="0.00011115230760041 0.000603852596441218 0.000587657443623324 -8.45752275895149e-9 5.15122491760907e-9 -1.29037854530489e-7" />
          <!-- URDF joint2 origin rpy = 1.5708 0 0 -->
          <joint name="joint2" pos="0 0 0" axis="0 -1 0" range="-3.1 3.1" actuatorfrcrange="-50 50" damping="0.2" />
          <geom type="mesh" rgba="0.87843137254902 0 0.129411764705882 1" mesh="link2" />
          <body name="link3" pos="0.4014 -0.0055 0" quat="1 0 0 0">
            <inertial pos="0.0356914460529407 -0.0127290421616784 -4.99847735601633E-05" mass="0.0763832349061947" fullinertia="0.0000230975481800775 0.0000302654097799572 0.0000262744379783613 -3.96632725546314e-7 1.43784025932649e-9 4.53169889578176e-8" />
            <!-- URDF joint3 origin rpy = 0 0 0 -->
            <joint name="joint3" pos="0 0 0" axis="1 0 0" range="-3.14 3.14" actuatorfrcrange="-50 50" damping="0.02" />
            <geom type="mesh" rgba="0.866666666666667 0.909803921568627 1 1" mesh="link3" />
            <body name="link4" pos="0.0430000000000001 -0.0199999999998909 0" quat="0 0 0.707106781187 0.707106781187">
              <inertial pos="-0.0725200807880995 0.0116284521818822 0.0206751464031625" mass="0.267547364804174" fullinertia="0.000159517801401972 0.000127171807362423 0.000155060226944876 7.59248239536197e-8 -5.5601365856691e-8 2.51609951433807e-7" />
              <!-- URDF joint4 origin rpy = 1.5707963267949 0 3.14159265358979 -->
              <joint name="joint4" pos="0 0 0" axis="0 0 1" range="-1.5708 1.5708" actuatorfrcrange="-50 50" damping="0.02" />
              <geom type="mesh" rgba="0.847058823529412 0.847058823529412 0.847058823529412 1" mesh="link4" />
              <site name="ee_site" pos="-0.1165 0 0" size="0.01" />
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
  <contact>
    <exclude body1="base_link" body2="link1" />
    <exclude body1="link1" body2="link2" />
    <exclude body1="link2" body2="link3" />
    <exclude body1="link3" body2="link4" />
  </contact>
  <!-- 执行器：位置伺服（MuJoCo 内置 PD）。
       ctrl 的语义就是"目标关节角"，正好对应 ros2_control 的 position 命令接口，
       所以 JointTrajectoryController 可以不加任何 PID 直接驱动这套模型。
       dampratio="1.0" 时 MuJoCo 会按该关节的实际等效惯量自动算出临界阻尼的 kv，
       因此只需要调 kp：kp 越大越"硬"、稳态下沉越小，过大则在数值上发散。
       下面这组 kp 沿用 src/model/robotic_arm.xml 的 joint1~joint4（100/800/500/50）：
       本臂质量/惯量与参考臂同量级（连杆 0.08~0.45 kg、惯量 2.3e-5~2.5e-3 kg·m²），
       沿用后仍需在仿真里实测微调。
       ctrlrange 取关节行程，MuJoCo 会把设定值夹在行程内。

       effort 上限：与 URDF 各关节的 <limit effort> 一致——本模型四个关节均为
       50 N·m。actuatorfrcrange 是 MuJoCo 侧的物理夹取，改 URDF 的 effort 时
       必须同步改这里。

       若要改成纯力矩控制（ros2_control 侧用 effort 命令接口 + 力矩控制器），
       用同目录的 robotic_arm_torque.xml / scene_torque.xml。
       MuJoCo 不允许在运行期切换执行器类型，所以这是二选一的编译期决定。 -->
  <actuator>
    <position name="motor1" joint="joint1" kp="100" dampratio="1.0" ctrllimited="true" ctrlrange="-1.5708 1.5708" />
    <position name="motor2" joint="joint2" kp="800" dampratio="1.0" ctrllimited="true" ctrlrange="-3.1 3.1" />
    <position name="motor3" joint="joint3" kp="500" dampratio="1.0" ctrllimited="true" ctrlrange="-3.14 3.14" />
    <position name="motor4" joint="joint4" kp="50" dampratio="1.0" ctrllimited="true" ctrlrange="-1.5708 1.5708" />
  </actuator>
  <sensor>
    <actuatorpos name="motor1_p" actuator="motor1" />
    <actuatorpos name="motor2_p" actuator="motor2" />
    <actuatorpos name="motor3_p" actuator="motor3" />
    <actuatorpos name="motor4_p" actuator="motor4" />
    <actuatorvel name="motor1_v" actuator="motor1" />
    <actuatorvel name="motor2_v" actuator="motor2" />
    <actuatorvel name="motor3_v" actuator="motor3" />
    <actuatorvel name="motor4_v" actuator="motor4" />
    <actuatorfrc name="motor1_f" actuator="motor1" noise="1e-3" />
    <actuatorfrc name="motor2_f" actuator="motor2" noise="1e-3" />
    <actuatorfrc name="motor3_f" actuator="motor3" noise="1e-3" />
    <actuatorfrc name="motor4_f" actuator="motor4" noise="1e-3" />
    <framepos name="ee_pos" objtype="site" objname="ee_site" />
    <framequat name="ee_quat" objtype="site" objname="ee_site" />
  </sensor>
</mujoco>
